# Postgres (o Railway injeta automaticamente via plugin)
DATABASE_URL=postgresql://usuario:senha@host:5432/vozza

# OpenAI — transcrição (Whisper) e limpeza (GPT-4o-mini)
OPENAI_API_KEY=sk-proj-...

# Mercado Pago — use TEST-... em desenvolvimento, APP_USR-... só em produção
MP_ACCESS_TOKEN=TEST-...
# Assinatura secreta dos webhooks do MP (painel: Suas integrações → Webhooks →
# Configurar notificações). Opcional: sem ela, o webhook aceita sem validar a
# assinatura (mas continua consultando a API antes de mudar qualquer plano).
MP_WEBHOOK_SECRET=

# Asaas — em avaliação para Pix automático (Mercado Pago ainda não libera
# isso pra esta conta). Chave de sandbox começa com $aact_hmlg_...
ASAAS_ACCESS_TOKEN=$aact_hmlg_...
# Token que você mesmo escolhe ao configurar o webhook no painel da Asaas
# (32-255 caracteres, sem espaços). Sem ele, /webhooks/asaas rejeita tudo.
ASAAS_WEBHOOK_TOKEN=troque-por-outro-token-aleatorio-forte

# Painel /admin — gere um valor forte (ex.: openssl rand -hex 32).
# Sem essa variável o painel fica fechado (503), de propósito.
ADMIN_TOKEN=troque-por-um-token-aleatorio-forte

# Porta local (o Railway define a dele sozinho)
PORT=4000
