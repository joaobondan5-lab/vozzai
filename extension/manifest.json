{
  "manifest_version": 3,
  "name": "Vozza — ditado por voz com IA",
  "version": "0.1.0",
  "description": "Fale e o texto aparece onde você estiver digitando no navegador.",
  "permissions": ["storage", "offscreen", "tabs"],
  "host_permissions": ["http://localhost:4000/*", "https://*.vozza.ai/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Vozza" },
  "commands": {
    "toggle-dictation": {
      "suggested_key": { "default": "Ctrl+Shift+Space", "mac": "Command+Shift+Space" },
      "description": "Iniciar/parar o ditado"
    }
  },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle" }
  ]
}
