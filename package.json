{
  "name": "vozza",
  "version": "0.2.0",
  "private": true,
  "description": "VozzAI — ditado por voz com IA, feito para o Brasil",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc && mkdir -p dist/renderer && cp src/renderer/*.html dist/renderer/",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "dist": "npm run build && electron-builder --mac --arm64"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@types/node": "^22.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "electron@33.4.11": true
  },
  "build": {
    "appId": "ai.vozza.app",
    "productName": "VozzAI",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "O VozzAI usa o microfone para transcrever a sua fala em texto."
      }
    },
    "afterSign": "build/notarize.js"
  }
}
